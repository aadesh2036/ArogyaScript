# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas (replace with your actual URI)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/arogyascript?retryWrites=true&w=majority

# JWT
JWT_SECRET=arogyascript_dev_secret_change_in_prod
JWT_EXPIRE=7d

# File Upload
UPLOAD_DIR=uploads

# Python ML Microservice
ML_PIPELINE_URL=http://localhost:8000

# OCR Service (Python)
OCR_SERVICE_URL=http://localhost:8001

# Pipeline Config
OCR_CONFIDENCE_THRESHOLD=0.75
DOSAGE_ANOMALY_THRESHOLD=0.6
INTERACTION_WEIGHT=0.35
