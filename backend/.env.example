PORT=5000
MONGO_URI=mongodb://localhost:27017/arogyascript
JWT_SECRET=arogyascript_dev_secret_change_in_prod
JWT_EXPIRE=7d
UPLOAD_DIR=uploads
ML_PIPELINE_URL=http://localhost:8000

# ── Gemini Explainable AI (DEPRECATED — replaced by Groq) ──
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash
# GEMINI_TIMEOUT_MS=15000
# GEMINI_MAX_RETRIES=2

# ── Groq Reasoning (Llama3-8B) ──
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_MS=15000
GROQ_MAX_RETRIES=2
REASONING_ENABLED=true

# ── LLM Entity Extraction Fallback ──
LLM_EXTRACTION_ENABLED=true
LLM_EXTRACTION_TIMEOUT_MS=12000
LLM_EXTRACTION_MAX_RETRIES=1

# ── Entity Confidence Threshold ──
MIN_ENTITY_CONFIDENCE=0.35
