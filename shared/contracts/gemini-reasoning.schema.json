{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arogyascript.dev/schemas/gemini-reasoning.schema.json",
  "title": "GeminiReasoning",
  "description": "Schema for Gemini Explainable AI output — gemini_reasoning_v1",
  "type": "object",
  "required": [
    "explainability_summary",
    "interaction_explanations",
    "anomaly_explanations",
    "interventions",
    "uncertainty_flags",
    "ocr_uncertainty_flags",
    "entity_reconciliation",
    "gemini_status",
    "reasoning_version"
  ],
  "properties": {
    "explainability_summary": {
      "type": "string",
      "description": "2-4 sentence human-readable summary of prescription risk, with provenance references."
    },
    "ocr_uncertainty_flags": {
      "type": "array",
      "description": "Low-confidence OCR tokens that may affect downstream analysis.",
      "items": {
        "type": "object",
        "required": ["text", "confidence", "concern"],
        "properties": {
          "text": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "concern": { "type": "string" }
        }
      }
    },
    "entity_reconciliation": {
      "type": "object",
      "description": "Evaluation of structured entity extraction completeness.",
      "properties": {
        "missing_fields": {
          "type": "array",
          "items": { "type": "string" }
        },
        "ambiguous_entities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "string" }
      }
    },
    "interaction_explanations": {
      "type": "array",
      "description": "Gemini-generated clinical explanations for each detected drug interaction.",
      "items": {
        "type": "object",
        "required": ["drugA", "drugB", "severity", "mechanism", "uncertain"],
        "properties": {
          "drugA": { "type": "string" },
          "drugB": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["low", "moderate", "high", "critical", "unknown"]
          },
          "mechanism": {
            "type": "string",
            "description": "Pharmacological mechanism of interaction."
          },
          "clinical_significance": {
            "type": "string",
            "description": "Patient-facing clinical impact."
          },
          "evidence_basis": {
            "type": "string",
            "description": "Pharmacological / trial evidence cited."
          },
          "uncertain": {
            "type": "boolean",
            "description": "True if Gemini cannot confidently explain the interaction."
          }
        }
      }
    },
    "anomaly_explanations": {
      "type": "array",
      "description": "Gemini explanations for each anomaly signal detected by the rule engine or ML model.",
      "items": {
        "type": "object",
        "required": ["signal_name", "clinical_meaning", "uncertain"],
        "properties": {
          "signal_name": { "type": "string" },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "clinical_meaning": { "type": "string" },
          "suggested_cause": { "type": "string" },
          "uncertain": { "type": "boolean" }
        }
      }
    },
    "interventions": {
      "type": "array",
      "description": "Prioritized, evidence-referenced clinical interventions generated by Gemini.",
      "items": {
        "type": "object",
        "required": ["priority", "action_type", "message"],
        "properties": {
          "priority": {
            "type": "string",
            "enum": ["urgent", "high", "medium", "low"]
          },
          "action_type": {
            "type": "string",
            "enum": ["consult_physician", "verify_dosage", "review_duplication", "manual_review", "monitor_lab", "other"]
          },
          "message": {
            "type": "string",
            "description": "Specific actionable clinical instruction."
          },
          "related_drugs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "evidence": {
            "type": "string",
            "description": "Rationale / evidence basis for this intervention."
          }
        }
      }
    },
    "uncertainty_flags": {
      "type": "array",
      "description": "Fields or outputs where Gemini has explicit uncertainty.",
      "items": {
        "type": "object",
        "required": ["field", "reason"],
        "properties": {
          "field": { "type": "string" },
          "reason": { "type": "string" },
          "impact": { "type": "string" }
        }
      }
    },
    "gemini_status": {
      "type": "string",
      "enum": ["success", "failed", "skipped"],
      "description": "Indicates whether live Gemini reasoning or fallback was used."
    },
    "reasoning_version": {
      "type": "string",
      "description": "Version tag for this reasoning schema. Current: gemini_reasoning_v1"
    },
    "durationMs": {
      "type": "number",
      "description": "Wall-clock time for the Gemini API call in milliseconds."
    },
    "error": {
      "type": ["string", "null"],
      "description": "Error message if gemini_status is failed."
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp when this reasoning was generated."
    }
  }
}
